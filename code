#include <iostream>
#include <windows.h>
int main() {
    /**
 * Практична робота №1
 * Тема: Структура програми C++
 * Завдання: Обчислення площі прямокутника
 */

    //Библиотека которая помогает с украинскими символами
    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);
    //Создаём переменные для сторон прямоугольника
    double first_side;
    double second_side;
    //Делаем проверку на ошибку с инпутом данных от пользователя в переменную (Если например введёт текст вместо чисел)
    if (!(std::cin >> first_side)) {
        std::cout << "Помилка вводу";
        return 1;
    }
    else if (!(std::cin >> second_side)) {
        std::cout << "Помилка вводу";
        return 1;
    }
    
    //Проверка на правильность ввода чисел для сторон
    if (first_side <= 0 || second_side <= 0) {
        std::cout << "Сторони не можуть бути від’ємними!" << std::endl;
        return 1;
    }
    //Считаем произвидение сторон и получаем площадь прямоугольника
    else {
        std::cout << "Площа прямокутника: " << first_side * second_side << std::endl;
    }
    return 0;
}
